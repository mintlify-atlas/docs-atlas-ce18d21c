  "keyFeatures": [
    "SQL and Go function migrations with up/down support",
    "Supports Postgres, MySQL, SQLite, ClickHouse, MSSQL, Spanner, YDB, TiDB, Turso, and more",
    "Embedded migrations via Go embed.FS",
    "Out-of-order (missing) migration support",
    "Environment variable substitution in SQL migrations",
    "Advisory locking (session and table-based) to prevent concurrent runs",
    "Custom store interface for bring-your-own dialect support",
    "Hybrid versioning with timestamp + sequential numbering",
    "Provider API for programmatic migration management",
    "Structured logging with slog support"
  ],
  "publicApiSurface": [
    "goose.NewProvider(dialect, db, fsys, opts...) (*Provider, error)",
    "Provider.Up(ctx) ([]*MigrationResult, error)",
    "Provider.UpByOne(ctx) (*MigrationResult, error)",
