    "Provider.GetVersions(ctx) (current, target int64, error)",
    "Provider.ListSources() []*Source",
    "goose.AddMigrationContext(up, down GoMigrationContext)",
    "goose.AddMigrationNoTxContext(up, down GoMigrationNoTxContext)",
    "goose.NewGoMigration(version, up, down *GoFunc) *Migration",
    "goose.SetGlobalMigrations(migrations ...*Migration) error",
    "goose.RunContext(ctx, command, db, dir, args...) error",
    "goose.RunWithOptionsContext(ctx, command, db, dir, args, opts...) error",
    "goose.SetBaseFS(fsys fs.FS)",
